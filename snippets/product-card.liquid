<article class="product-card">
  {% assign product_alt = product.featured_image.alt | default: product.title %}
  <a class="product-card__media" href="{{ product.url }}">
    {% if product.featured_image != blank %}
      {{ product.featured_image | image_url: width: 720 | image_tag: widths: '360, 540, 720', sizes: '(min-width: 990px) 25vw, (min-width: 640px) 33vw, 50vw', loading: 'lazy', alt: product_alt }}
    {% else %}
      <div class="product-card__placeholder" aria-hidden="true">✦</div>
    {% endif %}
    {% if product.compare_at_price > product.price %}<span class="product-card__badge">Oferta</span>{% endif %}
  </a>
  <div class="product-card__info">
    {% if product.vendor != blank %}<p class="product-card__vendor">{{ product.vendor }}</p>{% endif %}
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div class="product-card__price">
      {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}
      <span>{{ product.price | money }}</span>
    </div>
  </div>
</article>
