<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <meta name="theme-color" content="{{ settings.primary_color }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

    <title>
      {{ page_title }}{% if current_tags %} — {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} — Página {{ current_page }}{% endif %}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <style>
      :root {
        --primary: {{ settings.primary_color | default: '#118a50' }};
        --accent: {{ settings.accent_color | default: '#75c942' }};
        --bg: {{ settings.background_color | default: '#ffffff' }};
        --text: {{ settings.text_color | default: '#1f3b2b' }};
      }
    </style>
    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}">
    {% section 'header' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {% assign whatsapp_number = settings.whatsapp_number | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '+' %}
    {% if whatsapp_number != blank %}
      <a class="whatsapp-float" href="https://wa.me/{{ whatsapp_number }}?text={{ settings.whatsapp_message | default: 'Olá! Vim pelo site da Relvas do Campo.' | url_encode }}" target="_blank" rel="noopener" aria-label="Falar com a Relvas do Campo pelo WhatsApp">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5a9.5 9.5 0 0 0-8.2 14.3L2.6 21.4l4.8-1.2A9.5 9.5 0 1 0 12 2.5Z"/><path d="M8.6 7.8c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.7c.1.2.1.4-.1.6l-.5.6c.5 1 1.3 1.8 2.3 2.3l.6-.5c.2-.2.4-.2.6-.1l1.7.7c.3.1.4.3.4.5v.5c0 .3 0 .5-.4.7-.3.2-.9.4-1.3.3-1.1-.2-2.6-.9-3.8-2.1-1.2-1.2-1.9-2.7-2.1-3.8-.1-.5.1-1 .3-1.4Z"/></svg>
        <span>{{ settings.whatsapp_label | default: 'Fale conosco' }}</span>
      </a>
    {% endif %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {{ content_for_footer }}
  </body>
</html>
