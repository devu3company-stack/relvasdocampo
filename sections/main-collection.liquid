<section class="section section--collection">
  <div class="page-width">
    <div class="collection-heading">
      <p class="eyebrow">Nossa curadoria</p>
      <h1>{{ collection.title }}</h1>
      {% if collection.description != blank %}<div class="collection-heading__description">{{ collection.description }}</div>{% endif %}
    </div>

    <div class="collection-toolbar">
      <span>{{ collection.products_count }} produtos</span>
      <form class="sort-form" method="get">
        <label for="SortBy">Ordenar</label>
        <select id="SortBy" name="sort_by" onchange="this.form.submit()">
          {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
          {% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>{% endfor %}
        </select>
      </form>
    </div>

    {% paginate collection.products by 16 %}
      <div class="product-grid product-grid--collection">
        {% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<div class="empty-state"><h2>Nenhum produto encontrado</h2><p>Volte em breve para descobrir novidades.</p></div>{% endfor %}
      </div>
      {% if paginate.pages > 1 %}
        <nav class="pagination" aria-label="Paginação">
          {% if paginate.previous %}<a href="{{ paginate.previous.url }}" aria-label="Página anterior">←</a>{% endif %}
          <span>{{ paginate.current_page }} de {{ paginate.pages }}</span>
          {% if paginate.next %}<a href="{{ paginate.next.url }}" aria-label="Próxima página">→</a>{% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{ "name": "Coleção" }
{% endschema %}
