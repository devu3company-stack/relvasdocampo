<section class="section section--categories">
  <div class="page-width">
    <div class="section-heading section-heading--center">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    </div>

    <div class="category-grid">
      {% for block in section.blocks %}
        <a class="category-card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <div class="category-card__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 700 | image_tag: widths: '350, 700', loading: 'lazy', alt: block.settings.title }}
            {% else %}
              <div class="category-card__placeholder category-card__placeholder--{{ forloop.index }}" aria-hidden="true"><span>{{ block.settings.symbol }}</span></div>
            {% endif %}
          </div>
          <div class="category-card__content">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
            <span class="text-link">Explorar <span aria-hidden="true">→</span></span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categorias em destaque",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeno", "default": "Escolha por intenção" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Um universo para descobrir" },
    { "type": "textarea", "id": "text", "label": "Descrição", "default": "Encontre elementos para trazer mais significado aos seus rituais e ao seu dia a dia." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem" },
        { "type": "text", "id": "symbol", "label": "Símbolo quando não houver imagem", "default": "✦" },
        { "type": "text", "id": "title", "label": "Título", "default": "Produtos naturais" },
        { "type": "textarea", "id": "text", "label": "Descrição", "default": "Aromas, ervas e cuidados para o seu espaço." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorias em destaque",
      "blocks": [
        { "type": "category", "settings": { "symbol": "✦", "title": "Produtos naturais", "text": "Aromas, ervas e cuidados para o seu espaço." } },
        { "type": "category", "settings": { "symbol": "☾", "title": "Incensos e aromas", "text": "Perfumes para criar atmosferas de presença." } },
        { "type": "category", "settings": { "symbol": "◌", "title": "Velas e rituais", "text": "Luz, intenção e beleza em cada momento." } },
        { "type": "category", "settings": { "symbol": "✧", "title": "Guias e artefatos", "text": "Peças para acompanhar sua jornada." } }
      ]
    }
  ]
}
{% endschema %}
