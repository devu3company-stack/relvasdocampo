{% assign featured_collection = section.settings.collection %}
<section class="section section--products">
  <div class="page-width">
    <div class="section-heading section-heading--split">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
      </div>
      {% if featured_collection != blank %}
        <a class="text-link text-link--desktop" href="{{ featured_collection.url }}">Ver todos <span aria-hidden="true">→</span></a>
      {% endif %}
    </div>

    {% if featured_collection != blank and featured_collection.products_count > 0 %}
      <div class="product-grid">
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
      <a class="text-link text-link--mobile" href="{{ featured_collection.url }}">Ver todos <span aria-hidden="true">→</span></a>
    {% else %}
      <div class="empty-state">
        <p>Selecione uma coleção no editor do tema para exibir seus produtos aqui.</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Coleção em destaque",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeno", "default": "Escolhas da casa" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Mais procurados" },
    { "type": "textarea", "id": "text", "label": "Descrição", "default": "Peças e produtos que já fazem parte dos rituais de muitas pessoas." },
    { "type": "collection", "id": "collection", "label": "Coleção" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Produtos exibidos", "default": 4 }
  ],
  "presets": [{ "name": "Coleção em destaque" }]
}
{% endschema %}
